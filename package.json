{
  "name": "open-xlsx-editor",
  "version": "0.0.1",
  "description": "Open and edit .xlsx files in the browser. 100% JavaScript, no server, no Office.",
  "main": "src/index.js",
  "bin": {
    "open-xlsx-editor-mcp": "bin/oxe-mcp.mjs"
  },
  "type": "module",
  "scripts": {
    "test": "node test/unit.mjs",
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "fixtures": "node test/fixtures/make-fixtures.mjs",
    "test:e2e": "npm run build && node test/e2e.mjs && node test/editing.mjs && node test/editing-data.mjs && node test/editing-more.mjs && node test/a11y.mjs && node test/collab.mjs && node test/pdf.mjs",
    "check": "node tools/check-ooxml.mjs test/fixtures test/out",
    "lint": "eslint src test tools bin && node tools/scan-bytes.mjs"
  },
  "keywords": [
    "xlsx",
    "spreadsheet",
    "ooxml",
    "spreadsheetml",
    "editor",
    "viewer"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "axe-core": "^4.10.2",
    "esbuild": "^0.28.2",
    "eslint": "9.39.1",
    "globals": "15.15.0",
    "pdfjs-dist": "^2.16.105",
    "playwright": "^1.64.1",
    "yjs": "^13.6.33"
  },
  "exports": {
    ".": "./src/index.js",
    "./style.css": "./src/editor/editor.css",
    "./collab": "./src/collab.js",
    "./pdf": "./src/pdf.js"
  },
  "files": [
    "src",
    "dist",
    "bin"
  ],
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    }
  }
}
